# Copy to .streamlit/secrets.toml and fill in ONE provider to enable live AI advisories.
# Provider is auto-detected from whichever key is present.
# Optional tuning (any provider): LLM_MODEL, LLM_MAX_TOKENS, LLM_REASONING_EFFORT

# --- Groq (free, fast, OpenAI-compatible) ---
OPENAI_API_KEY = "gsk_..."
OPENAI_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "openai/gpt-oss-120b"
LLM_MAX_TOKENS = "900"
LLM_REASONING_EFFORT = "low"

# --- or Google Gemini (free) ---
# OPENAI_API_KEY = "AIza..."
# OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
# LLM_MODEL = "gemini-2.5-flash"

# --- or OpenRouter (OpenAI-compatible gateway; has :free models) ---
# OPENROUTER_API_KEY = "sk-or-v1-..."
# LLM_MODEL = "anthropic/claude-sonnet-5"

# --- or Anthropic directly ---
# ANTHROPIC_API_KEY = "sk-ant-..."
# LLM_MODEL = "claude-sonnet-5"
